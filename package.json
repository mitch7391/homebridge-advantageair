  "main": "dist/index.js",
  "files": [
    "assets/README.md",
    "assets/settings-header.png",
    "assets/settings-header.svg",
    "docs/v3-migration.md",
    "docs/native-package-transition.md",
    "docs/beta1-testing.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "config.schema.json",
    "LICENSE",
    "LICENSE.homebridge-template",
    "TEMPLATE_SOURCE.txt"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "node dev/beta-policy.mjs && npm run lint && npm run check:package",
    "simulator:start": "node dev/lab/lab.mjs simulator start",
    "simulator:stop": "node dev/lab/lab.mjs simulator stop",
    "simulator:status": "node dev/lab/lab.mjs simulator status",
    "lab:homebridge:start": "node dev/lab/lab.mjs homebridge start",
    "lab:homebridge:stop": "node dev/lab/lab.mjs homebridge stop",
    "lab:homebridge:status": "node dev/lab/lab.mjs homebridge status",
    "lab:start": "node dev/lab/lab.mjs start",
    "lab:stop": "node dev/lab/lab.mjs stop",
    "lab:status": "node dev/lab/lab.mjs status",
    "lab:logs": "node dev/lab/lab.mjs logs",
    "lab:logs:homebridge": "node dev/lab/lab.mjs logs homebridge",
    "lab:logs:simulator": "node dev/lab/lab.mjs logs simulator",
    "watch": "npm run build && npm link && nodemon",
    "test": "npm run build && node --test test/api/*.test.mjs test/discovery/*.test.mjs test/accessories/*.test.mjs",
    "prepack": "npm run build",
    "check:package": "node dev/package-check.mjs",
    "check:homebridge1": "node dev/compatibility/homebridge1.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "publishConfig": {
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
